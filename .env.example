# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/drift_db

# Redis
REDIS_URL=redis://:redispass@localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=admin-secret

# Security & Auth
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
ALLOWED_ORIGINS=http://localhost,https://localhost

# Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
PAGERDUTY_ROUTING_KEY=your-pd-routing-key

# General Config
ENVIRONMENT=development
DASHBOARD_HOST=localhost
LOG_LEVEL=INFO
BASELINE_WARMUP_MIN_SAMPLES=500
GRAFANA_ADMIN_PASSWORD=adminadmin123

# Application Specific
CIRCUIT_BREAKER_SERVICE_NAME=drift_interceptor
MODEL_VERSION=v1.0.0
